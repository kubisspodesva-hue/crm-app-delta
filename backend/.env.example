# --- Database ---
# DATABASE_URL: pooled connection (běžný provoz appky)
# DIRECT_URL: přímé (unpooled) připojení, používá se jen pro `prisma migrate`
DATABASE_URL="postgresql://delta_user:delta_password@localhost:5432/delta_db?schema=public"
DIRECT_URL="postgresql://delta_user:delta_password@localhost:5432/delta_db?schema=public"

# --- App ---
PORT=4000
NODE_ENV=development
FRONTEND_URL="http://localhost:3000"

# --- JWT ---
JWT_ACCESS_SECRET="change-me-access-secret"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_SECRET="change-me-refresh-secret"
JWT_REFRESH_EXPIRES_IN="7d"

# --- Google Calendar OAuth2 ---
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI="http://localhost:4000/calendar/google/callback"

# --- Security ---
ENCRYPTION_KEY="32-char-long-secret-key-for-tokens!"
